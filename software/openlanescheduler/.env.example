# OpenLane Scheduler Environment Configuration

# ── Lane configuration ──────────────────────────────────────────
# Which physical lanes this installation actually has, comma-separated.
# Defaults to a full 8-lane house (1-8) if unset. Drives backend
# validation (server.js, pmScheduler.js's maintenance-task generation)
# and mqtt-bridge's per-lane MQTT publishing.
# LANES=7,8
#
# Frontend/kiosk apps need the SAME lanes set at BUILD time, not here --
# Vite bakes import.meta.env.VITE_LANES in when the image is built, so it
# has to be passed as a docker build arg (see docker-compose.yml's
# frontend/kiosk-lanes-* services), not a runtime container env var.

# ── MQTT Hardware Integration (Optional) ────────────────────
# Uncomment to enable MQTT broker and bridge for ESP32/ESP8266 integration
# COMPOSE_PROFILES=mqtt

# ── Google Calendar Integration ──────────────────────────────
# Read-only sync (view reservations from Google Calendar)
# GCAL_API_KEY=your_api_key_here
# GCAL_CALENDAR_ID=your_calendar_id_here

# Write access (create/update/delete from UI)
# GCAL_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Sync interval in milliseconds (default: 120000 = 2 minutes)
# GCAL_SYNC_INTERVAL=120000

# ── Redis ─────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ── Backend ───────────────────────────────────────────────────
# PORT=3001

# ── Timezone ──────────────────────────────────────────────────
# TZ=America/Chicago

# ── MQTT Bridge Logging (when MQTT enabled) ──────────────────
# LOG_LEVEL=info  # Options: error, warn, info, debug
