# OpenLane Scheduler Environment Configuration

# ── MQTT Hardware Integration (Optional) ────────────────────
# Uncomment to enable MQTT broker and bridge for ESP32/ESP8266 integration
# COMPOSE_PROFILES=mqtt

# ── Google Calendar Integration ──────────────────────────────
# Read-only sync (view reservations from Google Calendar)
# GCAL_API_KEY=your_api_key_here
# GCAL_CALENDAR_ID=your_calendar_id_here

# Write access (create/update/delete from UI)
# GCAL_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Sync interval in milliseconds (default: 120000 = 2 minutes)
# GCAL_SYNC_INTERVAL=120000

# ── Redis ─────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ── Backend ───────────────────────────────────────────────────
# PORT=3001

# ── Timezone ──────────────────────────────────────────────────
# TZ=America/Chicago

# ── MQTT Bridge Logging (when MQTT enabled) ──────────────────
# LOG_LEVEL=info  # Options: error, warn, info, debug
